    "A backup couldn’t be created.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear un respaldo."
          }
        }
      }
    },
    "A backup couldn’t be restored.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo restaurar un respaldo."
          }
        }
      }
    },
    "A bundle identifier has at least two dot-separated parts, like com.apple.Safari.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un identificador de bundle tiene al menos dos partes separadas por punto, como com.apple.Safari."
          }
        }
      }
    },
    "A deterministic classifier tags each clip in under 5 ms — JWT, JSON, color, card, URL… — with zero network. Drives previews, Smart Actions, and masking.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clasificador determinista etiqueta cada clip en menos de 5 ms — JWT, JSON, color, tarjeta, URL… — sin red. Alimenta los previews, las Smart Actions y el enmascarado."
          }
        }
      }
    },
    "A faint wash of the selected clip’s color behind the list and the peek.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lavado tenue del color del clip seleccionado detrás de la lista y del peek."
          }
        }
      }
    },
    "A narrower scope reveals less clip data — never fewer verbs.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un alcance más estrecho revela menos datos del clip, nunca menos acciones."
          }
        }
      }
    },
    "A per-type limit overrides the global window; leave a type on Use global to follow it. Pinned clips and boards never expire.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un límite por tipo anula la ventana global; deja un tipo en Usar global para seguirla. Los clips fijados y los tableros nunca expiran."
          }
        }
      }
    },
    "A shareable stats card — generated on-device, never uploaded.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarjeta de estadísticas para compartir — generada en el dispositivo, nunca se sube."
          }
        }
      }
    },
    "A support bundle couldn’t be saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar un paquete de soporte."
          }
        }
      }
    },
