            "value": "Siempre activa"
          }
        }
      }
    },
    "Anonymous feature counts and broad performance buckets are off until you allow them. Clipboard content, titles, searches, and source-app names are never sent.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los conteos anónimos de funciones y los rangos generales de rendimiento están desactivados hasta que los autorices. Nunca se envían contenido del portapapeles, títulos, búsquedas ni nombres de apps de origen."
          }
        }
      }
    },
    "Answer": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respuesta"
          }
        }
      }
    },
    "Answers a question grounded only in your clip history, on-device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde una pregunta basándose solo en tu historial de clips, en el dispositivo."
