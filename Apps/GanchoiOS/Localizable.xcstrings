      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gancho nunca lee tu portapapeles en segundo plano."
          }
        }
      }
    },
    "Gancho never reads your pasteboard in the background. Capture happens only when you act: the save button, the share sheet, or a Shortcut.": {
